      "expected_route": "faq:recruit_deadline",
      "expected_answer_contains": ["报名"]
    },
    {
      "id": "faq-dev-near-miss-01",
      "split": "faq_cache_dev",
      "question": "能推荐一个适合我的导师吗？",
      "audience_scope": "guest",
      "expected_route": "rag_fallback",
      "expected_answer_contains": []
    },
    {
      "id": "faq-holdout-deadline-01",
      "split": "faq_cache_holdout",
      "question": "今年什么时候停止接收报名？",
      "audience_scope": "guest",
      "expected_route": "faq:recruit_deadline",
      "expected_answer_contains": ["报名"]
    },
    {
      "id": "faq-holdout-overreach-01",
      "split": "faq_cache_holdout",
