# ===== DashScope（通义千问）=====
# 必填：阿里云百炼创建的 API Key（https://bailian.console.aliyun.com）
# 使用：cp .env.example .env 后填入真实值
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxx
# 对话模型
LLM_MODEL=qwen-plus
# 备用对话模型（主模型不可用时切换，预留）
LLM_MODEL_FALLBACK=qwen-max
# Embedding 模型（固定 1024 维）
EMBEDDING_MODEL=text-embedding-v3
# LLM 调用超时（秒）
LLM_TIMEOUT=60

# ===== 轻量 Agent：M1 日期 / 知识工具（默认关闭，验收后启用）=====
AGENT_ENABLED=false
AGENT_MAX_TOOL_ROUNDS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_PREPARE_TIMEOUT_SECONDS=30
TOOLS_TIMEZONE=Asia/Shanghai
DOCUMENT_READ_ENABLED=false
CALCULATOR_ENABLED=false
WEB_SEARCH_ENABLED=false
WEB_READ_ENABLED=false
# 百炼 MCP 联网搜索；复用已有 DASHSCOPE_API_KEY，不再配置第二份密钥。
BAILIAN_MCP_WEB_SEARCH_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
# 首次真实连接后若服务发现多个搜索工具，可填控制台显示的精确工具名。
BAILIAN_MCP_WEB_SEARCH_TOOL=
BAILIAN_MCP_TIMEOUT_SECONDS=8
WEB_PAGE_TIMEOUT_SECONDS=8
WEB_MAX_REDIRECTS=3
WEB_MAX_RESPONSE_BYTES=2097152
WEB_PAGE_MAX_CHARS=12000

# ===== 服务 =====
# 注意：本机 Docker 里 chromadb 容器占了 8000，后端默认用 8100；停掉该容器后可改回 8000
APP_HOST=0.0.0.0
APP_PORT=8100

# ===== 用户认证与权限（Phase 4-02）=====
# 使用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成；必须自行填写
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# 本地 HTTP 调试 false；生产 HTTPS 必须改为 true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# 首次启动自动创建总管理员：admin 密码只放在本地 .env，创建成功后修改此项不会覆盖账号密码
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=请替换为至少12位强密码
INITIAL_ADMIN_NICKNAME=总管理员
# 审计 IP 哈希盐；空值时复用 JWT_SECRET，本地请使用独立随机值
AUDIT_HASH_SALT=

# ===== 文档治理（M1：AI 初标 + 人工审核后发布）=====
DOCUMENT_GOVERNANCE_ENABLED=true
DOCUMENT_PUBLISH_REQUIRES_ADMIN=true
# false：管理员可审核自己上传的资料；实验室人员充足时可改 true
REVIEW_SEPARATION_ENABLED=false
# 首次升级时保留历史 ready 文档可检索，并标记为历史待复核
LEGACY_DOCUMENTS_AUTO_PUBLISHED=true
DOCUMENT_EXPIRY_WARNING_DAYS=7
SENSITIVE_SCAN_ENABLED=true

# ===== 持久后台任务（M4）=====
# 本地开发用 inline；部署时改为 rq 并单独启动 Worker
TASK_MODE=inline
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE_NAME=rag-jobs
JOB_MAX_RETRIES=3
JOB_STALE_SECONDS=600
JOB_LOCK_TTL_SECONDS=900

# ===== 招新反馈（M5）=====
FEEDBACK_COMMENT_MAX_LENGTH=1000
FEEDBACK_RATE_LIMIT_PER_HOUR=20

# ===== 存储 =====
CHROMA_PERSIST_DIR=./data/chroma
# 数据库：MySQL（Docker）或 SQLite（本机零依赖，改回 sqlite:///./data/app.db 即可）
# MySQL 示例：mysql+pymysql://root:密码@127.0.0.1:3306/rag_assistant?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3306/rag_assistant?charset=utf8mb4

# ===== 文档处理 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ===== 检索 =====
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.45
MAX_CONTEXT_TOKENS=3000

# ===== 回答证据门槛（无足够证据时直接拒答）=====
EVIDENCE_GATE_ENABLED=true
# 原始向量余弦相似度下限；需用固定评测集校准
EVIDENCE_MIN_SIMILARITY=0.45
# 查询关键术语在单个 chunk 中的最小覆盖率
EVIDENCE_MIN_LEXICAL_COVERAGE=0.50
# 至少需要多少个支持证据块
EVIDENCE_MIN_SUPPORTING_CHUNKS=1
# 使用重排相关度判断候选是否真的包含答案，而不是仅仅主题相近
EVIDENCE_RERANK_ENABLED=true
# 高于接受线直接放行，低于拒绝线直接拒答；中间灰区交给 LLM 核验
EVIDENCE_RERANK_ACCEPT_SCORE=0.22
EVIDENCE_RERANK_REJECT_SCORE=0.15
EVIDENCE_JUDGE_ENABLED=true
EVIDENCE_JUDGE_MAX_CHUNKS=3
# 空值表示复用主对话模型
EVIDENCE_JUDGE_MODEL=
# 重排或灰区核验异常时保守拒答，降低幻觉风险
EVIDENCE_FAIL_CLOSED=true

# ===== 混合检索（Phase 3-06；false 时行为与 Phase 2 完全一致）=====
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_VECTOR_TOP_K=10
HYBRID_KEYWORD_TOP_K=10
HYBRID_FUSION_CANDIDATES=20
# 关键词侧是否也用改写查询（默认关：词面精确优先）
KEYWORD_USE_REWRITTEN=false
# jieba 自定义词典（相对项目根；型号/产品名分词不准时添加，格式：词 词频 词性）
KEYWORD_JIEBA_DICT=

# ===== 查询改写（Phase 3-01）=====
REWRITE_ENABLED=true
REWRITE_QUERY_COUNT=3
# 改写用模型；空 = 主模型（可设不存在的模型名验证降级）
REWRITE_MODEL=

# ===== 术语归一化（Phase 3-01 规则兜底）=====
# 口语别名 → 标准术语映射：编辑 data/term_aliases.json（不存在时用项目根
# term_aliases.example.json；改文件热生效，不用重启）。展开变体只喂关键词侧
TERM_ALIASES_ENABLED=true
# 单查询展开变体上限
TERM_ALIAS_MAX_EXPANSIONS=4

# ===== 重排（Phase 3-02；默认关，评估后开启）=====
RERANK_ENABLED=false
RERANK_TOP_N=5
RERANKER_TYPE=dashscope
# 实测（2026-08-31）：gte-rerank 需单独开通（403），v2/qwen3-rerank 直接可用
RERANK_MODEL=gte-rerank-v2

# ===== 复杂问题拆解与意图定向检索（默认关闭，先评估后开启） =====
QUERY_PLANNING_ENABLED=false
QUERY_PLAN_MAX_SUB_QUERIES=3
MAX_RETRIEVAL_QUERIES=6
TOPIC_RETRIEVAL_ENABLED=false
TOPIC_RETRIEVAL_TOP_K=10
TOPIC_COVERAGE_PER_SUB_QUERY=1
RETRIEVAL_TOPICS_FILE=./data/retrieval_topics.json
# 文档上传完成后由 AI 生成待审核主题；管理员批准前不会参与定向检索
AI_TOPIC_LABELING_ENABLED=true
AI_TOPIC_LABEL_MAX=3

# ===== 会话保留（自动清理）=====
# 超过 N 天未更新的活跃会话 → 逻辑删除（可恢复）；软删超 M 天 → 物理删除
# 启动时清一次 + 每 6 小时定时
SESSION_RETENTION_DAYS=3
SESSION_PURGE_DAYS=30
SESSION_CLEANUP_INTERVAL_HOURS=6
