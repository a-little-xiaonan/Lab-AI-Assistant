# ===== DashScope（通义千问）=====
# 必填：阿里云百炼创建的 API Key（https://bailian.console.aliyun.com）
# 使用：cp .env.example .env 后填入真实值
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxx
# 对话模型
LLM_MODEL=qwen-plus
# 备用对话模型（主模型不可用时切换，预留）
LLM_MODEL_FALLBACK=qwen-max
# Embedding 模型（固定 1024 维）
EMBEDDING_MODEL=text-embedding-v3
# LLM 调用超时（秒）
LLM_TIMEOUT=60

# ===== 服务 =====
# 注意：本机 Docker 里 chromadb 容器占了 8000，后端默认用 8100；停掉该容器后可改回 8000
APP_HOST=0.0.0.0
APP_PORT=8100

# ===== 存储 =====
CHROMA_PERSIST_DIR=./data/chroma
# 数据库：MySQL（Docker）或 SQLite（本机零依赖，改回 sqlite:///./data/app.db 即可）
# MySQL 示例：mysql+pymysql://root:密码@127.0.0.1:3306/rag_assistant?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3306/rag_assistant?charset=utf8mb4

# ===== 文档处理 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ===== 检索 =====
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.45
MAX_CONTEXT_TOKENS=3000

# ===== 混合检索（Phase 3-06；false 时行为与 Phase 2 完全一致）=====
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_VECTOR_TOP_K=10
HYBRID_KEYWORD_TOP_K=10
HYBRID_FUSION_CANDIDATES=20
# 关键词侧是否也用改写查询（默认关：词面精确优先）
KEYWORD_USE_REWRITTEN=false
# jieba 自定义词典（相对项目根；型号/产品名分词不准时添加，格式：词 词频 词性）
KEYWORD_JIEBA_DICT=

# ===== 查询改写（Phase 3-01）=====
REWRITE_ENABLED=true
REWRITE_QUERY_COUNT=3
# 改写用模型；空 = 主模型（可设不存在的模型名验证降级）
REWRITE_MODEL=

# ===== 重排（Phase 3-02；默认关，评估后开启）=====
RERANK_ENABLED=false
RERANK_TOP_N=5
RERANKER_TYPE=dashscope
# 实测（2026-08-31）：gte-rerank 需单独开通（403），v2/qwen3-rerank 直接可用
RERANK_MODEL=gte-rerank-v2

# ===== 会话保留（自动清理）=====
# 超过 N 天未更新的活跃会话 → 逻辑删除（可恢复）；软删超 M 天 → 物理删除
# 启动时清一次 + 每 6 小时定时
SESSION_RETENTION_DAYS=3
SESSION_PURGE_DAYS=30
SESSION_CLEANUP_INTERVAL_HOURS=6
